{
    "timezone": "Asia/Seoul",
    "endpoint": "/v3.0/search/detections",
    "timeout": 120,
    "top": 5000,
    "mode": "default",
    "verify_ssl": false,
    "request_interval": 5,
    "retry_wait": 65,
    "max_retries": 5,
    "queries": {
        "am": "productCode:sds AND eventName:MALWARE_DETECTION",
        "ips": "productCode:sds AND eventName:DEEP_PACKET_INSPECTION_EVENT"
    }
}
